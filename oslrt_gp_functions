weibull <- function(shape, median_surv, time){
  stopifnot(length(median_surv)==(length(time)-1))
  if((length(shape)==1) & (length(median_surv)>1)){
    shape <- rep(shape, length(median_surv))
  }
  if(length(time)==2){
    time <- c(time[1]:time[2])
    haz <- shape*(log(2)/median_surv^shape)*time^(shape-1)
    cumhaz <- log(2)*(time/median_surv)^shape
    surv <- exp(-log(2)*(time/(median_surv*365))^shape)
    F <- 1 - surv
  }
  else{
    times <- c(0)
    haz <- c(shape[1]*(log(2)/median_surv[1]^shape[1])*times^(shape[1]-1))
    cumhaz <- c(log(2)*(times/median_surv[1])^shape[1])
    surv <- c(exp(-log(2)*(times/(median_surv[1]*365))^shape[1]))
    for(i in 1:(length(time)-1)){
      t <- c((time[i]+1):time[i+1])
      times <- c(times,t)
      s <- shape[i]
      m <- median_surv[i]
      haz <- c(haz,s*(log(2)/m^s)*t^(s-1))
      cumhaz <- c(cumhaz,log(2)*(t/m)^s)
      surv <- c(surv,exp(-log(2)*(t/(m*365))^s))
    }
    F <- 1 - surv
    time <- times
  }
  data.frame(t = time, hazard = haz, cum_hazard = cumhaz, surv = surv, F = F) 
}


################################################################################
#################################Gamma Process##################################
################################################################################

GammaSampler <- R6::R6Class("GammaSampler", list(
  
  Dat = NA, # Data
  Par = NA, #Parameters
  Tim = NA, # Prespecified time point
  H = NA,
  Surv = NA,
  
  initialize = function(L, R, Tim, size = 1000, c = 1) {
    
    self$Dat <- list(L=L, R=R, ind=which(L < R)) 
    #ind = censored observations
    # L = R corresponds to an observed event
    
    self$Par <- list(size = size, c = c, lambda = log(2)/median(L))
    
    self$Tim <- Tim
  }, 
  
  ####  Possible based function
  H0 = function(t, lambda){
    lambda*t
  },
  
  S0 = function(t, lambda){
    exp(-self$H0(t, lambda = lambda))
  },
  
  #### Sample an event time jump from the Kalbfleisch posterior
  jump_sample = function(a, size){
    z <- runif(size)
    
    A <- exp(log(a) + z*(log(a+1) - log(a)))
    
    U <- rexp(size, rate = A)
    
    return(U)
  },
  
  #### Posterior sampling of H and S
  
  sample = function(){
    c <- self$Par$c
    size <- self$Par$size
    lambda <- self$Par$lambda
    
    L <- self$Dat$L
    R <- self$Dat$R
    
    ##Observed event times##
    event <- (L == R)
    event_times <- sort(unique(L[event]))
    
    d_event <- table(L[event])
    
    if(any(d_event > 1)){
      stop("Tied event are not supported by this implementation of the Kalbfleisch Gamma Process.")
    }
    
    grid <- sort(unique(c(0, self$Tim, L)))
    
    ng <- length(grid)
    
    H_grid <- matrix(0, nrow = ng, ncol = size)
    
    H_current <- numeric(size)
    
    for(j in 2:ng){
      t_left <- grid[j-1]
      t_right <- grid[j]
      
      Y <- sum(L >= t_left & R > t_left)
      
      dH0 <- self$H0(t_right, lambda = lambda) - self$H0(t_left, lambda = lambda)
      
      if(dH0 > 0){
        dH <- rgamma(n = size, shape = c*dH0, rate = c+Y)
        H_current <- H_current+dH
      }
      
      is_event <- t_right %in% event_times

      if(is_event){
        Y_event <- sum(L >= t_right)
        jump <- self$jump_sample(a = c+Y_event, size = size)
        
        H_current <- H_current + jump
      }
      
      H_grid[j, ] <- H_current
    }
    
    tim_index <- match(self$Tim, grid)
    
    self$H <- H_grid[tim_index, , drop = FALSE]
    
    self$Surv <- exp(-self$H)
    
    invisible(self)
  }
))


################################################################################
#################OSLRT and its modified version#################################
################################################################################

OSLRT <- function(time, event, rate_exp, shape_weib, scale_weib, shape_llogis,
                  scale_llogis, mean_lnorm, sd_lnorm, mu_gengamma,
                  sigma_gengamma, Q_gengamma, distr){
  X <- time
  delta <- event
  if(distr=='Exponential'){
    S <- function(u, rate){1-pexp(u, rate)}
    H <- function(u, rate){-log(S(u, rate))}
    M <- H(X, rate_exp)
  }
  if(distr=='Weibull'){
    S <- function(u, shape, scale){1-pweibull(u, shape, scale)}
    H <- function(u, shape, scale){-log(S(u, shape, scale))}
    M <- H(X, shape_weib, scale_weib)
  }
  if(distr=='Log-logistic'){
    S <- function(u, shape, scale){1-pllogis(u, shape, scale)}
    H <- function(u, shape, scale){-log(S(u, shape, scale))}
    M <- H(X, shape_llogis, scale_llogis) 
  }
  if(distr=='Log-normal'){
    S <- function(u, mean, sd){1-plnorm(u, mean, sd)}
    H <- function(u, mean, sd){-log(S(u, mean, sd))}
    M <- H(X, mean_lnorm, sd_lnorm)
  }
  if(distr=='Gen Gamma'){
    S <- function(u, mu, sigma, Q){1-pgengamma(u, mu, sigma, Q)}
    H <- function(u, mu, sigma, Q){-log(S(u, mu, sigma, Q))}
    M <-H(X, mu_gengamma, sigma_gengamma, Q_gengamma)
  }
  O <- sum(delta)
  E <- sum(M)
  Z <- (O-E)/sqrt(E)
  pvalue <- 1-pnorm(-Z)
  return(c(Z, pvalue))
}

mOSLRT <- function(time, event, rate_exp, shape_weib, scale_weib, shape_llogis,
                   scale_llogis, mean_lnorm, sd_lnorm, mu_gengamma,
                   sigma_gengamma, Q_gengamma, distr){
  X <- time # observed failure time 
  delta <- event # censoring indicate 1-event 0-censoring 
  if(distr=='Exponential'){
    S <- function(u, rate){1-pexp(u, rate)}
    H <- function(u, rate){-log(S(u, rate))}
    M <- H(X, rate_exp)
  }
  if(distr=='Weibull'){
    S <- function(u, shape, scale){1-pweibull(u, shape, scale)}
    H <- function(u, shape, scale){-log(S(u, shape, scale))}
    M <- H(X, shape_weib, scale_weib)
  }
  if(distr=='Log-logistic'){
    S <- function(u, shape, scale){1-pllogis(u, shape, scale)}
    H <- function(u, shape, scale){-log(S(u, shape, scale))}
    M <- H(X, shape_llogis, scale_llogis) 
  }
  if(distr=='Log-normal'){
    S <- function(u, mean, sd){1-plnorm(u, mean, sd)}
    H <- function(u, mean, sd){-log(S(u, mean, sd))}
    M <- H(X, mean_lnorm, sd_lnorm)
  }
  if(distr=='Gen Gamma'){
    S <- function(u, mu, sigma, Q){1-pgengamma(u, mu, sigma, Q)}
    H <- function(u, mu, sigma, Q){-log(S(u, mu, sigma, Q))}
    M <-H(X, mu_gengamma, sigma_gengamma, Q_gengamma)
  }
  O <- sum(delta)       # observed number of events 
  E <- sum(M)
  V <- (O+E)/2
  Z <- (O-E)/sqrt(V)
  pvalue <- 1-pnorm(-Z)
  return(c(Z, pvalue))
}


################################################################################
#############Generation of experimental group under H0##########################
################################################################################

generate_exp <- function(sampling, s, nexp){
  u <- runif(nexp)
  Hs <- sampling$H[, s]
  grid <- sampling$Tim
  htarget <- -log(u)
  keep <- !duplicated(Hs)
  Tgen <- approx(x = Hs[keep], y = grid[keep], xout = htarget, method = 'linear', rule = 1)$y
  return(Tgen)
}

build_exp <- function(Texp, Cexp, tau){
  C_adm <- rep(tau, length(Texp))
  delta_exp <- as.numeric(!is.na(Texp) & Texp <= C_adm)
  t_exp <- pmin(Texp, C_adm, na.rm = TRUE)
  list(time = t_exp, status = delta_exp)
}


################################################################################
########################OSLRT bayesian##########################################
################################################################################

OSLRT_bayesian_unique <- function(sampling, t_exp, delta_exp, s){
  H_GP <-  approx(x = sampling$Tim, y = sampling$H[, s], xout = t_exp, method = 'linear')$y
  O <- sum(delta_exp)
  E_GP <- sum(H_GP)
  Z_oslrt <- (O - E_GP)/sqrt(E_GP)
  Z_moslrt <- (O - E_GP)/sqrt((O + E_GP)/2)
  return(c(Z_oslrt, Z_moslrt))
}


################################################################################
##########################Simulate H0###########################################
################################################################################

simulate_Z <- function(sampling, Cexp, nexp, tau, net){
  B <- ncol(sampling$H)
  Z_H0_oslrt <- numeric(B*net)
  Z_H0_moslrt <- numeric(B*net)
  idx <- 1
  for(s in 1:B){
    for(e in 1:net){
      Texp <- generate_exp(sampling = sampling, s = s, nexp = nexp)
      data_exp <- build_exp(Texp = Texp, Cexp = Cexp, tau = tau)
      Z <- OSLRT_bayesian_unique(sampling = sampling, t_exp = data_exp$time, delta_exp = data_exp$status, s = s)
      Z_H0_oslrt[idx] <- Z[1]
      Z_H0_moslrt[idx] <- Z[2]
      idx <- idx+1
    }
  }
  return(list(oslrt = Z_H0_oslrt, moslrt = Z_H0_moslrt))
}


################################################################################
######################Computation of pval#######################################
################################################################################

compute_pval <- function(sampling, T_exp_obs, delta_exp_obs, rate_exp, shape_weib, scale_weib, shape_llogis,
                         scale_llogis, mean_lnorm, sd_lnorm, mu_gengamma, sigma_gengamma, Q_gengamma, distr, tau, net){
  Z_obs_oslrt <- OSLRT(time = T_exp_obs, event = delta_exp_obs, rate_exp = rate_exp, shape_weib = shape_weib, 
                       scale_weib = scale_weib, shape_llogis = shape_llogis, scale_llogis = scale_llogis, 
                       mean_lnorm = mean_lnorm, sd_lnorm = sd_lnorm, mu_gengamma = mu_gamma, sigma_gengamma = sigma_gengamma, 
                       Q_gengamma = Q_gengamma, distr = distr)[1]
  Z_obs_moslrt <- mOSLRT(time = T_exp_obs, event = delta_exp_obs, rate_exp = rate_exp, shape_weib = shape_weib, 
                         scale_weib = scale_weib, shape_llogis = shape_llogis, scale_llogis = scale_llogis, 
                         mean_lnorm = mean_lnorm, sd_lnorm = sd_lnorm, mu_gengamma = mu_gamma, sigma_gengamma = sigma_gengamma, 
                         Q_gengamma = Q_gengamma, distr = distr)[1]
  nexp <- length(T_exp_obs)
  C_obs <- T_exp_obs[which(delta_exp_obs==0)]
  Z_sim <- simulate_Z(sampling = sampling, Cexp = C_obs, nexp = nexp, tau = tau, net = net)
  pvalue_oslrt <- mean(Z_sim$oslrt <= Z_obs_oslrt)
  pvalue_moslrt <- mean(Z_sim$moslrt <= Z_obs_moslrt)
  return(c(bosl = pvalue_oslrt, bmosl = pvalue_moslrt))
}


################################################################################
########################Parallelisation#########################################
################################################################################

one_sim <- function(i, nexp, shape0, scale0, sampling_cont, len, shape1, scale1,
                    CP, ta, tf, lambda_cens, net){
  set.seed(i)
  
  time <- rweibull(n = nexp, shape = shape1, scale = scale1)
  #time <- nphsim::rpwexp(n = nexp, rate = c(1/scale0*1, 1/scale0*0.5), intervals = CP, cumulative = FALSE)
  u <- runif(n = nexp, min = 0, max = ta)
  
  if(lambda_cens==0){  #administrative censoring
    del <- rep(1, nexp)
    t <- pmin(time, ta+tf-u)
    delta <- ifelse(time < ta+tf-u, del, 0)
  }
  else{   #lost during FU + administrative censoring
    cens <- stats::rexp(nexp, lambda_cens)
    time <- ifelse(time < cens, time, cens)
    del <- ifelse(time < cens, 1, 0)
    t <- pmin(time, ta+tf-u)
    delta <- ifelse(time < ta+tf-u, del, 0)
  }
  
  a <- OSLRT(time = t, event = delta, shape_weib = shape0, scale_weib = scale0, distr = 'Weibull')[2]
  b <- mOSLRT(time = t, event = delta, shape_weib = shape0, scale_weib = scale0, distr = 'Weibull')[2]
  c <- compute_pval(sampling = sampling_cont, T_exp_obs = t, delta_exp_obs = delta, shape_weib = shape0, 
                    scale_weib = scale0, distr = 'Weibull', tau = ta+tf, net = net)
  
  out <- data.frame(n_pat = nexp,
                    n_evts = sum(delta),
                    err_oslrt = ifelse((a<0.05), 1, 0),
                    err_moslrt = ifelse((b<0.05), 1, 0),
                    err_bay_oslrt = ifelse((c[1]<0.05), 1, 0),
                    err_bay_moslrt = ifelse((c[2]<0.05), 1, 0))
  return(out)
}
