one_sim <- function(i, nexp, shape0, scale0, shape_llogis, scale_llogis, sampling_cont, len, shape1, scale1,
                    CP, ta, tf, lambda_cens, net){
  set.seed(i)
  
  time <- rweibull(n = nexp, shape = shape1, scale = scale1)
  #time <- nphsim::rpwexp(n = nexp, rate = c(1/scale0*1, 1/scale0*0.5), intervals = CP, cumulative = FALSE)
  u <- runif(n = nexp, min = 0, max = ta)
  
  if(lambda_cens==0){  #administrative censoring
    del <- rep(1, nexp)
    t <- pmin(time, ta+tf-u)
    delta <- ifelse(time < ta+tf-u, del, 0)
  }
  else{   #lost during FU + administrative censoring
    cens <- stats::rexp(nexp, lambda_cens)
    time <- ifelse(time < cens, time, cens)
    del <- ifelse(time < cens, 1, 0)
    t <- pmin(time, ta+tf-u)
    delta <- ifelse(time < ta+tf-u, del, 0)
  }
  
  #a <- OSLRT(time = t, event = delta, shape_weib = shape0, scale_weib = scale0, distr = 'Weibull')[2]
  #b <- mOSLRT(time = t, event = delta, shape_weib = shape0, scale_weib = scale0, distr = 'Weibull')[2]
  #c <- compute_pval(sampling = sampling_cont, T_exp_obs = t, delta_exp_obs = delta,  shape_weib = shape0, 
  #                  scale_weib = scale0, distr = 'Weibull',tau = ta+tf, net = net)
  a <- OSLRT(time = t, event = delta, shape_llogis = shape_llogis, scale_llogis = scale_llogis, distr = "Log-logistic")[2]
  b <- mOSLRT(time = t, event = delta, shape_llogis = shape_llogis, scale_llogis = scale_llogis, distr = "Log-logistic")[2]
  c <- compute_pval(sampling = sampling_cont, T_exp_obs = t, delta_exp_obs = delta, shape_llogis = shape_llogis, 
                    scale_llogis = scale_llogis, distr = "Log-logistic", tau = ta+tf, net = net)
  
  out <- data.frame(n_pat = nexp,
                    n_evts = sum(delta),
                    err_oslrt = ifelse((a<0.05), 1, 0),
                    err_moslrt = ifelse((b<0.05), 1, 0),
                    err_bay_oslrt = ifelse((c[1]<0.05), 1, 0),
                    err_bay_moslrt = ifelse((c[2]<0.05), 1, 0))
  return(out)
}
