compute_pval <- function(sampling, T_exp_obs, delta_exp_obs, rate_exp, shape_weib, scale_weib, shape_llogis,
                         scale_llogis, mean_lnorm, sd_lnorm, mu_gengamma, sigma_gengamma, Q_gengamma, distr, tau, net){
  Z_obs_oslrt <- OSLRT(time = T_exp_obs, event = delta_exp_obs, rate_exp = rate_exp, shape_weib = shape_weib, 
                       scale_weib = scale_weib, shape_llogis = shape_llogis, scale_llogis = scale_llogis, 
                       mean_lnorm = mean_lnorm, sd_lnorm = sd_lnorm, mu_gengamma = mu_gamma, sigma_gengamma = sigma_gengamma, 
                       Q_gengamma = Q_gengamma, distr = distr)[1]
  Z_obs_moslrt <- mOSLRT(time = T_exp_obs, event = delta_exp_obs, rate_exp = rate_exp, shape_weib = shape_weib, 
                         scale_weib = scale_weib, shape_llogis = shape_llogis, scale_llogis = scale_llogis, 
                         mean_lnorm = mean_lnorm, sd_lnorm = sd_lnorm, mu_gengamma = mu_gamma, sigma_gengamma = sigma_gengamma, 
                         Q_gengamma = Q_gengamma, distr = distr)[1]
  nexp <- length(T_exp_obs)
  C_obs <- T_exp_obs[which(delta_exp_obs==0)]
  Z_sim <- simulate_Z(sampling = sampling, Cexp = C_obs, nexp = nexp, tau = tau, net = net)
  pvalue_oslrt <- mean(Z_sim$oslrt <= Z_obs_oslrt)
  pvalue_moslrt <- mean(Z_sim$moslrt <= Z_obs_moslrt)
  return(c(bosl = pvalue_oslrt, bmosl = pvalue_moslrt))
}

