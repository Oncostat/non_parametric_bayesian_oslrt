generate_exp <- function(sampling, s, nexp){
  the_s <- sampling$The[s]
  u <- runif(nexp)
  Tgen <- sampling$G_ppf(u, the_s, sampling$Dat$shape, sampling$Dat$scale)
  return(Tgen)
}

build_exp <- function(Texp, Cexp, tau){
  #C_clin <- sample(Cexp, size = length(Texp), replace = TRUE)
  C_adm <- rep(tau, length(Texp))
  #Cens <- pmin(C_clin, C_adm)
  t_exp <- pmin(Texp, C_adm)
  delta_exp <- as.numeric(Texp <= C_adm)
  list(time = t_exp, status = delta_exp)
}

################################################################################
########################OSLRT bayesian##########################################
################################################################################

OSLRT_bayesian_unique <- function(sampling, t_exp, delta_exp, s){
  surv_DP <- dirichlet_unique(sampling = sampling, s = s, grid = sort(t_exp))
  H_DP <-  -log(surv_DP)
  O <- sum(delta_exp)
  E_DP <- sum(H_DP)
  Z_oslrt <- (O - E_DP)/sqrt(E_DP)
  Z_moslrt <- (O - E_DP)/sqrt((O + E_DP)/2)
  return(c(Z_oslrt, Z_moslrt))
}

################################################################################
##########################Simulate H0###########################################
################################################################################

simulate_Z <- function(sampling, Cexp, nexp, tau, net){
  B <- ncol(sampling$Tim)
  Z_H0_oslrt <- numeric(B*net)
  Z_H0_moslrt <- numeric(B*net)
  idx <- 1
  for(s in 1:B){
    for(e in 1:net){
      Texp <- generate_exp(sampling = sampling, s = s, nexp = nexp)
      data_exp <- build_exp(Texp = Texp, Cexp = Cexp, tau = tau)
      Z <- OSLRT_bayesian_unique(sampling = sampling, t_exp = data_exp$time, delta_exp = data_exp$status, s = s)
      Z_H0_oslrt[idx] <- Z[1]
      Z_H0_moslrt[idx] <- Z[2]
      idx <- idx+1
    }
  }
  return(list(oslrt = Z_H0_oslrt, moslrt = Z_H0_moslrt))
}

